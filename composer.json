{
  "name": "laravel-tipi/filament-support",
  "description": "Shared Filament support utilities for Laravel Tipi packages",
  "keywords": ["laravel", "filament", "support", "utilities"],
  "type": "library",
  "license": "MIT",
  "authors": [{"name": "Irakli", "email": "iraklikevkhishvili@gmail.com"}],
  "require": {
    "php": "^8.5",
    "illuminate/support": "^13.0",
    "illuminate/validation": "^13.0"
  },
  "require-dev": {
    "laravel/pint": "^1.0",
    "pestphp/pest": "^4.0"
  },
  "autoload": {"psr-4": {"Tipi\\Filament\\": "src/"}},
  "autoload-dev": {"psr-4": {"Tipi\\Filament\\Tests\\": "tests/"}},
  "scripts": {
    "test": "pest",
    "format": "pint",
    "format:test": "pint --test",
    "check": ["@format:test", "@test"]
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {"pestphp/pest-plugin": true}
  },
  "support": {
    "issues": "https://github.com/laravel-tipi/filament-support/issues",
    "source": "https://github.com/laravel-tipi/filament-support"
  }
}
